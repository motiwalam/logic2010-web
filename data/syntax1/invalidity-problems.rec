problem: Inval 6.001
argument: %xFx=A  .:  forall x (Fx<->x=A)
interpretation: F(1)

problem: Inval 6.002
argument: F%xFx  .:  exists y forall x (Fx<->x=y)
interpretation: F(1)

problem: Inval 6.003
argument: %xFx=%xx<>x  .:  ~exists y forall x (Fx<->x=y)
interpretation: F(1)

problem: Inval 6.004
argument: %xFx=%xGx  .:  forall x (Fx<->Gx)
interpretation: F(1).G(1)

problem: Inval 6.005
argument: exists x  A(x)=B(x)  .:  forall y  %xA(x)=y = %xB(x)=y
interpretation: A(1).B(1)

problem: Inval 6.006
argument: F%xR(xA(x))  .:  exists y F%xR(xy)
interpretation: F(1).R(2).A(1)

problem: Inval 6.007
argument: .:  exists y  y=%xR(xy)
interpretation: R(2)

problem: Inval 6.008
argument: forall z ~exists y forall x (Hz<->x=y)  .:  %zHz = %xx<>x
interpretation: H(1)

problem: Inval 6.009
argument: exists y forall x (R(xy)<->x=y)  .:  R(%xR(xy) y)
interpretation: R(2)

problem: Inval 6.010
argument: exists y exists x (R(xx)<->x=y)  .:  exists y forall x (R(x%xR(xx))<->x=y)
interpretation: R(2)

problem: Inval 6.011
argument: exists y forall x (Fx<->x=y).  ~exists y forall x (~Fx<->x=y)  .:  %xFx=%x~Fx
interpretation: F(1)

problem: Inval 6.012
argument: exists y forall x (Fx<->x=y).  ~exists y forall x (Gx<->x=y)  .:  %xFx<>%xGx
interpretation: F(1).G(1)
