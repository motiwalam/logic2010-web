##                          CHAPTER VI
##                DEFINITE DESCRIPTIONS
PrD        exists y forall x (Fx<->x=y) .: F%xFx
ImD        ~exists y forall z (Fz<->z=y) .: %zFz=%x~x=x
##                      DERIVED RULES
## Special Proper Descriptions
## T406
SPRD1      exists y forall x (Fx<->x=y) .: forall x (Fx<->x=%xFx)
SPRD2      ~%xFx=%x~x=x .: forall x (Fx<->x=%xFx)
## 
SPRD       SPRD1.SPRD2
