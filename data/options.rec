# Core-problem-specific alterations
# assume QN for some homework problems
assume-weakly: QN:{"3.001","3.019"}
# disable QN for problems whose comments specify it
disable-all-forms: QN:{"3.411","3.412","3.419","3.420","4.001","4.014"}
# disable CD and ID for problems whose comments specify it
disable-all-forms: CD.ID.DD/C.DD/I:{"4.280","4.288"}
# disable CD, ID, and DD for problems whose comments specify it
disable-all-forms: CD.ID.DD:{"4.290","4.298"}
# disable IE and CIE for problems whose comments specify it
disable-all-forms: IE.CIE:{"3.213","3.215","6.404","6.405"}
# disable ASS ID for problems whose comments specify it
disable-all-forms: ID/I.CD/I.DD/I:{"1.0001","1.0005"}
# disable command mode for problems whose comments specify it
option: noCommand:{"4.290","4.298"}
# Assumption of derived rules and theorems
# assume the derived rules of Chapter II
assume-weakly: MC.NCJ.SC.CDJ.TRANS.CJB.NC.NB.DM.DIST.COM.ASSOC.EXP.BP.SSimp.BEX:u{"1.7","1.72","1.8","1.82","2.7","2.72","2.8","2.82","3.7","3.72","3.8","3.82","4.7","4.72","4.8","4.82","5.7","5.72","5.8","5.82","6.7","6.72","6.8","6.82"}
