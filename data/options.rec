# assume the derived rules of Chapter V
assume-weakly: LL2.LL3.LL4.LL5.Sm.EL.QElim:u{"1.7","1.72","1.8","1.82","2.7","2.72","2.8","2.82","3.7","3.72","3.8","3.82","4.7","4.72","4.8","4.82","5.7","5.72","5.8","5.82","6.7","6.72","6.8","6.82"}
